{
  "expo": {
    "name": "Barbon Performance Analysis",
    "slug": "barbon-performance-analysis",
    "scheme": "barbonanalysis",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.barbonperformance.analysis"
    },
    "android": {
      "package": "com.barbonperformance.analysis",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Barbon Performance needs access to your videos so you can send them to your coach."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
