    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "vite": "^8.2.2"
